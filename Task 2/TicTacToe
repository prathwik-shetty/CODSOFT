import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class TicTacToe extends JFrame implements ActionListener {

    JButton[] board = new JButton[9];
    boolean gameFinished = false;

    public TicTacToe() {

        setTitle("Tic Tac Toe - AI");
        setSize(400, 400);
        setLayout(new GridLayout(3, 3));
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        for (int i = 0; i < 9; i++) {
            board[i] = new JButton("");
            board[i].setFont(new Font("Arial", Font.BOLD, 40));
            board[i].addActionListener(this);
            add(board[i]);
        }

        setVisible(true);
    }

    @Override
    public void actionPerformed(ActionEvent e) {

        if (gameFinished) return;

        JButton clicked = (JButton) e.getSource();

        if (!clicked.getText().equals("")) return;

        clicked.setText("X");

        if (checkWin("X")) {
            JOptionPane.showMessageDialog(this, "You win!");
            gameFinished = true;
            return;
        }

        computerMove();

        if (checkWin("O")) {
            JOptionPane.showMessageDialog(this, "Computer wins!");
            gameFinished = true;
        } else if (isBoardFull()) {
            JOptionPane.showMessageDialog(this, "Draw!");
            gameFinished = true;
        }
    }

    void computerMove() {

        int bestScore = -1000;
        int move = -1;

        for (int i = 0; i < 9; i++) {
            if (board[i].getText().equals("")) {

                board[i].setText("O");
                int score = minimax(false);
                board[i].setText("");

                if (score > bestScore) {
                    bestScore = score;
                    move = i;
                }
            }
        }

        board[move].setText("O");
    }

    int minimax(boolean computerTurn) {

        if (checkWin("O")) return 1;
        if (checkWin("X")) return -1;
        if (isBoardFull()) return 0;

        if (computerTurn) {

            int best = -1000;

            for (int i = 0; i < 9; i++) {
                if (board[i].getText().equals("")) {
                    board[i].setText("O");
                    best = Math.max(best, minimax(false));
                    board[i].setText("");
                }
            }
            return best;

        } else {

            int best = 1000;

            for (int i = 0; i < 9; i++) {
                if (board[i].getText().equals("")) {
                    board[i].setText("X");
                    best = Math.min(best, minimax(true));
                    board[i].setText("");
                }
            }
            return best;
        }
    }

    boolean checkWin(String player) {

        int[][] win = {
                {0,1,2},{3,4,5},{6,7,8},
                {0,3,6},{1,4,7},{2,5,8},
                {0,4,8},{2,4,6}
        };

        for (int[] w : win) {
            if (board[w[0]].getText().equals(player) &&
                    board[w[1]].getText().equals(player) &&
                    board[w[2]].getText().equals(player)) {
                return true;
            }
        }
        return false;
    }

    boolean isBoardFull() {
        for (JButton b : board) {
            if (b.getText().equals("")) return false;
        }
        return true;
    }

    public static void main(String[] args) {
        new TicTacToe();
    }
}

